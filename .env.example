# Copie para .env (nunca versionado) antes de rodar docker compose up --build.
# Qualquer provedor compatível com a API da OpenAI.

# Google Gemini (usado no MVP):
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini-embedding-001

# OpenAI (padrão das specs): deixe LLM_BASE_URL vazio,
# LLM_MODEL=gpt-4o-mini e EMBEDDING_MODEL=text-embedding-3-small.

# Limiar de similaridade (R02). Calibrado em 07/11 com gemini-embedding-001 nos
# manuais de demo: respostas corretas ficaram entre 0.64 e 0.72 e perguntas fora do
# escopo perto de 0.47. Recalibre com `python -m app.retrieval.inspect` ao trocar
# de modelo de embedding ou de manuais.
SIMILARITY_THRESHOLD=0.60
