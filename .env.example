# Copie para .env (nunca versionado) antes de rodar docker compose up --build.
# Qualquer provedor compatível com a API da OpenAI.

# Google Gemini (usado no MVP):
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
# Fallback da geração (429/5xx/rede ou primeiro token lento). No Gemini gratuito a cota
# (15 RPM, 500 RPD) é por modelo, então principal + fallback somam as duas cotas.
LLM_FALLBACK_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini-embedding-001

# OpenAI (padrão das specs): deixe LLM_BASE_URL vazio,
# LLM_MODEL=gpt-4o-mini e EMBEDDING_MODEL=text-embedding-3-small.

# Limiar de similaridade (R02). Calibrado em 07/11 com gemini-embedding-001 nos
# manuais de demo: respostas corretas ficaram entre 0.64 e 0.72 e perguntas fora do
# escopo perto de 0.47. Recalibre com `python -m app.retrieval.inspect` ao trocar
# de modelo de embedding ou de manuais.
SIMILARITY_THRESHOLD=0.60

# Token do painel /admin/metricas (cabeçalho X-Admin-Token de GET /api/v1/metrics/summary).
# Vazio deixa a rota sempre em 401. Defina um token longo (ex.: saída de
# `openssl rand -hex 24`); o painel /admin/metricas pede esse valor.
ADMIN_TOKEN=

# Mock checkout confirmado desconta o estoque no PostgreSQL. Rodar de novo
# `docker compose run --rm ingest` restaura o estoque do data/catalog.json.
CHECKOUT_DECREMENT_STOCK=true
